{
  "name": "programa-artesanos",
  "version": "1.0.0",
  "description": "Programa Escolar de Artesanos - Web full stack (Node + Express + PostgreSQL/Supabase)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "node setup.js",
    "db:schema": "node -e \"require('./supabase/supabaseClient').runSchema()\"",
    "db:seed": "node -e \"require('./supabase/supabaseClient').runSeed()\"",
    "db:users": "node -e \"require('./supabase/supabaseClient').runUsers()\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "@supabase/supabase-js": "^2.45.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
